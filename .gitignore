# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled binary output
bin/
tmp/

# Root-level compiled binaries (no extension) — e.g. go build output
/api
/main


# Test binary, built with `go test -c`
*.test

# Go coverage output
*.out
coverage/

# Dependency directories
# vendor/

# Go workspace file
go.work
go.work.sum

# Env files (keep .env.example committed)
.env
.env.local
.env.*
!.env.example

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific files
.DS_Store
Thumbs.db

# Log files
*.log

# Air live-reloading tool temp directory
tmp/
